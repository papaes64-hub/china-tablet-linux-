#!/usr/bin/env bash

SCREEN="eDP-1"
TOUCH="silead_ts_unfolded touchscreen"
KEYBOARD="AT Translated Set 2 keyboard"

LOCK="${XDG_RUNTIME_DIR:-/tmp}/linux-tablet-autorotate.lock"
LOG="$HOME/.cache/linux-tablet-autorotate.log"

exec 9>"$LOCK"
flock -n 9 || exit 0

last_orientation=""

keyboard_enable() {
    xinput enable "$KEYBOARD" 2>/dev/null || true
}

keyboard_disable() {
    xinput disable "$KEYBOARD" 2>/dev/null || true
}

onboard_start() {
    pgrep -x onboard >/dev/null || {
        nohup onboard </dev/null \
            >"$HOME/.cache/onboard.log" 2>&1 &
    }
}

onboard_stop() {
    pkill -x onboard 2>/dev/null || true
}

set_laptop_ui() {
    gsettings set org.nemo.preferences click-policy 'double'
    # Компактная панель и обычный курсор.
    gsettings set org.cinnamon panels-height "['1:25']"
    gsettings set org.cinnamon.desktop.interface cursor-size 24

    # Возвращаем исходные размеры Onboard.
    gsettings set org.onboard.window docking-enabled false
    gsettings set org.onboard.theme-settings key-size 94.0

    gsettings set org.onboard.window.landscape width 700
    gsettings set org.onboard.window.landscape height 205
    gsettings set org.onboard.window.landscape dock-height 205

    gsettings set org.onboard.window.portrait width 600
    gsettings set org.onboard.window.portrait height 200
    gsettings set org.onboard.window.portrait dock-height 200
}

set_tablet_ui() {
    gsettings set org.nemo.preferences click-policy 'single'
    # Панель и значки приложений становятся крупнее.
    gsettings set org.cinnamon panels-height "['1:42']"
    gsettings set org.cinnamon.desktop.interface cursor-size 34

    # Большая клавиатура, закреплённая снизу во всю ширину.
    gsettings set org.onboard.window docking-enabled true
    gsettings set org.onboard.window docking-edge 'bottom'
    gsettings set org.onboard.window docking-shrink-workarea true

    gsettings set org.onboard.window.landscape dock-expand true
    gsettings set org.onboard.window.landscape dock-height 270
    gsettings set org.onboard.window.landscape height 270

    gsettings set org.onboard.window.portrait dock-expand true
    gsettings set org.onboard.window.portrait dock-height 320
    gsettings set org.onboard.window.portrait height 320

    gsettings set org.onboard.theme-settings key-size 100.0
}


# BEGIN LinuxTablet touchpad
set_touchpad()
{
    STATE="$1"

    while IFS= read -r DEV
    do
        [ -n "$DEV" ] || continue

        if [ "$STATE" = "on" ]; then
            xinput enable "$DEV" 2>/dev/null || true
        else
            xinput disable "$DEV" 2>/dev/null || true
        fi
    done < <(
        xinput list --name-only 2>/dev/null |
        grep -i 'touchpad'
    )
}
# END LinuxTablet touchpad

set_laptop_mode() {
    set_touchpad on
    keyboard_enable
    onboard_stop
    set_laptop_ui
}

set_tablet_mode() {
    set_touchpad off
    keyboard_disable
    set_tablet_ui
    sleep 0.3
    onboard_start
}

rotate_tablet() {
    local orientation="$1"
    local rotation
    local matrix
    local mode

    [ "$orientation" = "$last_orientation" ] && return
    last_orientation="$orientation"

    case "$orientation" in
        bottom-up)
            rotation="normal"
            matrix="1 0 0 0 1 0 0 0 1"
            mode="laptop"
            ;;
        normal)
            rotation="inverted"
            matrix="-1 0 1 0 -1 1 0 0 1"
            mode="tablet"
            ;;
        left-up)
            rotation="left"
            matrix="0 -1 1 1 0 0 0 0 1"
            mode="tablet"
            ;;
        right-up)
            rotation="right"
            matrix="0 1 0 -1 0 1 0 0 1"
            mode="tablet"
            ;;
        *)
            return
            ;;
    esac

    xrandr --output "$SCREEN" --rotate "$rotation"

    for i in $(seq 1 30); do
        xinput list --name-only | grep -Fxq "$TOUCH" && break
        sleep 0.1
    done

    xinput set-prop "$TOUCH" \
        "Coordinate Transformation Matrix" $matrix

    if [ "$mode" = "laptop" ]; then
        set_laptop_mode
    else
        set_tablet_mode
    fi

    printf '%s sensor=%s screen=%s mode=%s\n' \
        "$(date '+%H:%M:%S')" \
        "$orientation" "$rotation" "$mode" >> "$LOG"
}

setxkbmap -layout "us,ru" -option "grp:alt_shift_toggle"

while IFS= read -r line; do
    if [[ "$line" =~ (bottom-up|normal|left-up|right-up)$ ]]; then
        rotate_tablet "${BASH_REMATCH[1]}"
    fi
done < <(stdbuf -oL -eL monitor-sensor 2>&1)
